# Fragmento de revisão apenas — não instalar diretamente.
# O Job é temporário e deve ser preenchido somente após preflight e autorização
# separada; não inventar ou reutilizar um Job histórico.
# Os demais parâmetros permanecem no EnvironmentFile root-owned canônico.
PHILIPS_FOLDER_ALLOW_TENANT_ID=2
PHILIPS_FOLDER_ALLOW_DESTINATION_ID=7
PHILIPS_FOLDER_DESTINATION_ID=7
PHILIPS_FOLDER_MODE=single_test
PHILIPS_FOLDER_ALLOW_JOB_ID=<job_id_unico_autorizado>
