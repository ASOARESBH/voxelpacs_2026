[Unit]
Description=VOXEL PACS restricted report delivery gateway bridge
After=network-online.target docker.service
Wants=network-online.target

[Service]
Type=simple
User=root
Group=root
EnvironmentFile=/etc/voxelpacs/report-delivery-gateway-bridge.env
ExecStart=/usr/bin/python3 /opt/voxelpacs/report-delivery-gateway/bridge_server.py
Restart=no
NoNewPrivileges=true
PrivateTmp=true
ProtectHome=true
ProtectSystem=strict
ReadWritePaths=/var/lib/voxelpacs/report-delivery-gateway /run/docker.sock
ReadOnlyPaths=/opt/voxelpacs/report-delivery-gateway /etc/voxelpacs/report-delivery-gateway
UMask=0077

[Install]
WantedBy=multi-user.target
