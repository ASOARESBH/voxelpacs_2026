# Arquivo root-owned (0600). Não armazenar em Git valores reais de VPN, mTLS,
# HMAC, diretório do receptor ou qualquer identificador clínico.
PHILIPS_FOLDER_BIND_IP=<endereco_privado_da_bridge>
PHILIPS_FOLDER_BIND_PORT=<porta_privada>
PHILIPS_FOLDER_DESTINATION_ID=<id_do_destino_philips_folder>
# single_test aceita exclusivamente PHILIPS_FOLDER_ALLOW_JOB_ID.
# destination só pode ser usado após homologação e aprovação de automação.
PHILIPS_FOLDER_MODE=single_test
PHILIPS_FOLDER_ALLOW_JOB_ID=<id_unico_de_teste>
# Diretório existente abaixo de /var/lib/voxelpacs/philips-folder-target, nunca um caminho fornecido pelo PACS.
PHILIPS_FOLDER_TARGET_DIRECTORY=<diretorio_local_gerenciado_do_gateway>
PHILIPS_FOLDER_HMAC_FILE=<arquivo_root_only_hmac>
PHILIPS_FOLDER_CLIENT_CA_FILE=<ca_mtls>
PHILIPS_FOLDER_SERVER_CERT_FILE=<certificado_mtls_da_bridge>
PHILIPS_FOLDER_SERVER_KEY_FILE=<chave_privada_mtls_da_bridge>
# Transporte remoto: SFTP é o preferencial. A bridge, e nunca o PACS, acessa o peer privado.
PHILIPS_FOLDER_TRANSPORT=sftp
# Vazio ou smb; smb só é permitido como fallback de sftp para falhas transitórias.
PHILIPS_FOLDER_FALLBACK=smb
# O peer privado WireGuard; não usar IP público, rota padrão ou rede PACS/DICOM.
PHILIPS_FOLDER_VPN_PEER_HOST=<peer_ipv4_privado>
PHILIPS_SFTP_HOST=<mesmo_peer_ipv4_privado>
PHILIPS_SFTP_PORT=22
PHILIPS_SFTP_USER=<usuario_sftp_restrito>
PHILIPS_SFTP_REMOTE_PATH=<diretorio_remoto_absoluto>
# Arquivos regulares root-only (0600), fora de Git e nunca expostos pela API ou logs.
PHILIPS_SFTP_PRIVATE_KEY=<chave_privada_ssh_root_only>
PHILIPS_SFTP_KNOWN_HOSTS=<known_hosts_root_only>
PHILIPS_SMB_HOST=<mesmo_peer_ipv4_privado>
PHILIPS_SMB_SHARE=<share_restrito>
PHILIPS_SMB_REMOTE_PATH=/
PHILIPS_SMB_USER=<usuario_smb_restrito>
PHILIPS_SMB_DOMAIN=
# Arquivo root-only no formato aceito por mount.cifs, contendo a identidade SMB protegida.
PHILIPS_SMB_CREDENTIALS_FILE=<arquivo_credencial_smb_root_only>
