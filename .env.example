# ============================================================
# VOXEL PACS — Variáveis de Ambiente
# Copie este arquivo para .env e preencha os valores
# NUNCA suba o arquivo .env para o repositório
# ============================================================

# ------------------------------------------------------------
# Aplicação
# ------------------------------------------------------------
APP_NAME="VOXEL PACS"
APP_ENV=local
# URL pública do ERP inlaudo (usada para redirecionamento do Viewer)
VIEWER_ERP_URL=http://localhost:8000
APP_DEBUG=true
SESSION_TIMEOUT=3600

# Segurança
APP_SECRET=chave_secreta_32_chars_aqui

# ------------------------------------------------------------
# Banco de Dados
# ------------------------------------------------------------
DB_HOST=127.0.0.1
DB_PORT=3306
DB_DATABASE=voxelpacs
DB_USERNAME=root
DB_PASSWORD=

# ------------------------------------------------------------
# Integração ORTHANC PACS Server
# ------------------------------------------------------------
ORTHANC_URL=http://localhost:8042
ORTHANC_USER=admin
ORTHANC_PASS=orthanc
ORTHANC_AE_TITLE=VOXELPACS
ORTHANC_DICOM_PORT=4242

# ------------------------------------------------------------
# Integração Viewer DICOM (OHIF Viewer)
# ------------------------------------------------------------
# URL base do OHIF Viewer
VIEWER_URL=http://localhost:3000
# Endpoint DICOMweb (usado pelo OHIF)
DICOM_URL=http://localhost:8042/dicom-web

# Adapter opcional de medições do viewer. Mantenha false até homologação clínica.
VOXEL_MEASUREMENT_ADAPTER_ENABLED=false

# Delivery Hub de laudos. Mantenha false até aplicar a migration, implantar o
# worker e homologar um destino específico por cliente.
VOXEL_REPORT_DELIVERY_HUB_ENABLED=false
# Gere com: openssl rand -hex 32. Deve coincidir com o .env privado do worker no VPS.
VOXEL_REPORT_DELIVERY_WORKER_TOKEN=CHANGE_ME_GENERATE_64_HEX_CHARACTERS

# ------------------------------------------------------------
# SLA e Indicadores (minutos)
# ------------------------------------------------------------
SLA_URGENCIA_MINUTOS=60
SLA_ROTINA_MINUTOS=240

# ------------------------------------------------------------
# E-mail
# ------------------------------------------------------------
MAIL_HOST=smtp.gmail.com
MAIL_PORT=587
MAIL_USERNAME=
MAIL_PASSWORD=
MAIL_FROM=noreply@voxelpacs.com.br
MAIL_FROM_NAME="VOXEL PACS"

# ------------------------------------------------------------
# Armazenamento e Uploads
# ------------------------------------------------------------
# Caminho absoluto para a pasta storage (vazio para usar o padrão da app)
STORAGE_PATH=
UPLOAD_MAX_SIZE=50M
