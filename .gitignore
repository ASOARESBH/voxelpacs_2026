# ==============================================================================
# VOXEL PACS — .gitignore
# Regras de exclusão para desenvolvimento PHP/Node em múltiplos SOs e IDEs
# ==============================================================================

# ------------------------------------------------------------------------------
# Dependências
# ------------------------------------------------------------------------------
/vendor/
/node_modules/

# ------------------------------------------------------------------------------
# Configurações Locais e Ambiente
# ------------------------------------------------------------------------------
.env
.env.*
!.env.example
phpunit.xml
phpunit.result.cache

# ------------------------------------------------------------------------------
# Segredos, dumps e artefatos de infraestrutura
# ------------------------------------------------------------------------------
*.pem
*.key
*.p12
*.pfx
*.crt
*.dump
/backups/
/backup/
/bck_git_v1/
/database/backups/
/database/dumps/

# ------------------------------------------------------------------------------
# Armazenamento e Logs
# ------------------------------------------------------------------------------
/storage/*
/uploads/
/logs/
/tmp/*
/cache/*

# Manter a estrutura de diretórios vazios
!/storage/logs/
!/storage/logs/.gitkeep
!/storage/uploads/
!/storage/uploads/.gitkeep
!/storage/uploads/.htaccess
!/storage/sessions/
!/storage/sessions/.gitkeep
!/storage/cache/
!/storage/cache/.gitkeep

# ------------------------------------------------------------------------------
# Build e Compilação
# ------------------------------------------------------------------------------
/public/build/
/public/hot/
/public/mix-manifest.json
/build/
/dist/
npm-debug.log
yarn-error.log

# ------------------------------------------------------------------------------
# IDEs e Editores
# ------------------------------------------------------------------------------
# JetBrains (PHPStorm, WebStorm, etc)
.idea/
*.iws
*.iml
*.ipr
out/

# Visual Studio Code
.vscode/
*.code-workspace
.history/

# Sublime Text
*.sublime-workspace
*.sublime-project

# Vim
*.swp
*.swo
*~

# ------------------------------------------------------------------------------
# Sistemas Operacionais
# ------------------------------------------------------------------------------
# macOS
.DS_Store
.AppleDouble
.LSOverride
Icon
._*
.DocumentRevisions-V100
.fseventsd
.Spotlight-V100
.TemporaryItems
.Trashes
.VolumeIcon.icns
.com.apple.timemachine.donotpresent

# Windows
Thumbs.db
Thumbs.db:encryptable
ehthumbs.db
ehthumbs_vista.db
*.cab
*.lnk
$RECYCLE.BIN/

# Linux
*~
.directory

# ------------------------------------------------------------------------------
# Específicos do Projeto
# ------------------------------------------------------------------------------
# (Adicione aqui exclusões específicas do projeto)
*.zip
*.tar.gz
/voxelpacs_deploy_*.zip
