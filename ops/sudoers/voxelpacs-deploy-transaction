# VOXEL PACS — sudoers mínimo para inspeção/reconciliação de transações.
# Instalar somente como root após validação com visudo.
manus-admin ALL=(root) NOPASSWD: /usr/local/sbin/voxelpacs-deploy-transaction inspect --sha [a-f0-9]*
manus-admin ALL=(root) NOPASSWD: /usr/local/sbin/voxelpacs-deploy-transaction reconcile --sha [a-f0-9]*
manus-deploy ALL=(root) NOPASSWD: /usr/local/sbin/voxelpacs-deploy-transaction inspect --sha [a-f0-9]*
manus-deploy ALL=(root) NOPASSWD: /usr/local/sbin/voxelpacs-deploy-transaction reconcile --sha [a-f0-9]*
