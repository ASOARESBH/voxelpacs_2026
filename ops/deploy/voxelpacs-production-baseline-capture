#!/usr/bin/env bash
# VOXEL PACS — captura root-controlled e fail-closed do baseline produtivo.
# O caller só pode solicitar a operação fixa "capture"; não há path ou comando livre.
set -Eeuo pipefail
umask 077
export PATH='/usr/sbin:/usr/bin:/sbin:/bin'

readonly SOURCE_ROOT='/var/www/voxelpacs/app'
readonly OUTPUT_ROOT='/var/lib/voxelpacs/baselines'
readonly CAPTURE_SCRIPT='/usr/local/sbin/voxelpacs-capture-production-baseline'
readonly MECHANISM_VERSION='1'

fail() {
  printf 'BASELINE_CAPTURE=BLOCKED\nREASON=%s\nPRODUCTION_CHANGED=NO\n' "$1" >&2
  exit 64
}

require_root_and_caller() {
  [[ "$EUID" -eq 0 ]] || fail 'ROOT_REQUIRED'
  case "${SUDO_USER:-}" in
    ''|manus-admin) ;;
    *) fail 'CALLER_NOT_ALLOWLISTED' ;;
  esac
}

require_root_and_caller
[[ "$#" -eq 1 && "$1" == 'capture' ]] || fail 'ARGUMENTS_INVALID'
[[ -x "$CAPTURE_SCRIPT" && ! -L "$CAPTURE_SCRIPT" ]] || fail 'CAPTURE_SCRIPT_UNAVAILABLE'
[[ -d "$SOURCE_ROOT" && ! -L "$SOURCE_ROOT" ]] || fail 'SOURCE_ROOT_INVALID'
[[ -d "$(dirname -- "$OUTPUT_ROOT")" && ! -L "$(dirname -- "$OUTPUT_ROOT")" ]] || fail 'OUTPUT_PARENT_INVALID'

result_file="$(mktemp /var/tmp/voxelpacs-production-baseline.XXXXXX)"
cleanup() {
  /usr/bin/rm -f -- "$result_file"
}
trap cleanup EXIT

if ! "$CAPTURE_SCRIPT" \
  --source-root "$SOURCE_ROOT" \
  --output-dir "$OUTPUT_ROOT" \
  --require-complete >"$result_file" 2>/dev/null; then
  hash_unavailable="$(/usr/bin/awk -F= '$1 == "HASH_UNAVAILABLE" {print $2; exit}' "$result_file")"
  [[ "$hash_unavailable" =~ ^[0-9]+$ ]] || hash_unavailable='UNKNOWN'
  printf 'BASELINE_CAPTURE=INCOMPLETE\nHASH_UNAVAILABLE=%s\nOUTPUT_PUBLISHED=NO\nPRODUCTION_CHANGED=NO\nDATABASE_CHANGED=NO\nWORKER_STARTED=NO\nTRANSMISSION=NO\n' "$hash_unavailable"
  exit 65
fi

baseline_id="$(/usr/bin/awk -F= '$1 == "BASELINE_ID" {print $2; exit}' "$result_file")"
file_count="$(/usr/bin/awk -F= '$1 == "FILE_COUNT" {print $2; exit}' "$result_file")"
symlink_count="$(/usr/bin/awk -F= '$1 == "SYMLINK_COUNT" {print $2; exit}' "$result_file")"
excluded_count="$(/usr/bin/awk -F= '$1 == "EXCLUDED_COUNT" {print $2; exit}' "$result_file")"
[[ "$baseline_id" =~ ^[0-9a-f]{40}$ ]] || fail 'BASELINE_ID_INVALID'
[[ "$file_count" =~ ^[0-9]+$ ]] || fail 'FILE_COUNT_INVALID'
[[ "$symlink_count" =~ ^[0-9]+$ ]] || fail 'SYMLINK_COUNT_INVALID'
[[ "$excluded_count" =~ ^[0-9]+$ ]] || fail 'EXCLUDED_COUNT_INVALID'

printf 'BASELINE_CAPTURE=PASS\nMECHANISM_VERSION=%s\nBASELINE_ID=%s\nFILE_COUNT=%s\nSYMLINK_COUNT=%s\nEXCLUDED_COUNT=%s\nSECRETS_CAPTURED=NO\nPERSISTENT_CONTENT_CAPTURED=NO\nCLINICAL_CONTENT_CAPTURED=NO\nPRODUCTION_CHANGED=YES\nDATABASE_CHANGED=NO\nWORKER_STARTED=NO\nTRANSMISSION=NO\n' \
  "$MECHANISM_VERSION" "$baseline_id" "$file_count" "$symlink_count" "$excluded_count"
