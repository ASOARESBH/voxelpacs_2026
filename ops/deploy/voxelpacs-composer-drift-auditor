#!/usr/bin/env bash
# VOXEL PACS — auditor root-controlled do metadata Composer.
#
# Somente leitura. Compara o alvo fixo no artefato (stdin), runtime e baseline.
# Nunca imprime hashes de conteúdo, conteúdo de arquivos ou dados operacionais.
set -Eeuo pipefail
umask 077
export PATH='/usr/sbin:/usr/bin:/sbin:/bin'

readonly APP_ROOT='/var/www/voxelpacs/app'
readonly BASELINE_ROOT='/var/lib/voxelpacs/baselines'
readonly TARGET_RELATIVE_PATH='vendor/composer/installed.php'
readonly MECHANISM_VERSION='1'

fail() {
  printf 'COMPOSER_AUDIT=BLOCKED\nREASON=%s\nPRODUCTION_CHANGED=NO\nDATABASE_CHANGED=NO\nWORKER_STARTED=NO\nTRANSMISSION=NO\n' "$1" >&2
  exit 64
}

usage() {
  printf '%s\n' 'uso: voxelpacs-composer-drift-auditor --baseline-id <40-hex-sha> --artifact-sha <40-hex-sha>' >&2
}

is_sha() {
  [[ "${1:-}" =~ ^[0-9a-f]{40}$ ]]
}

require_root_and_caller() {
  [[ "$EUID" -eq 0 ]] || fail 'ROOT_REQUIRED'
  case "${SUDO_USER:-}" in
    ''|manus-admin) ;;
    *) fail 'CALLER_NOT_ALLOWLISTED' ;;
  esac
}

safe_relative_path() {
  local rel="$1"
  [[ -n "$rel" && "$rel" != /* && "$rel" != '.' ]] || return 1
  [[ "$rel" != *$'\n'* && "$rel" != *$'\r'* && "$rel" != *$'\t'* ]] || return 1
  [[ "$rel" != '../'* && "$rel" != */../* && "$rel" != */.. && "$rel" != '..' ]] || return 1
  # shellcheck disable=SC2221,SC2222
  case "$rel" in
    .env|.env.*|*/.env|*/.env.*|storage|storage/*|*/storage|*/storage/*|uploads|uploads/*|*/uploads|*/uploads/*|public/uploads|public/uploads/*|*/public/uploads|*/public/uploads/*|logs|logs/*|*/logs|*/logs/*|backups|backups/*|*/backups|*/backups/*|runtime|runtime/*|*/runtime|*/runtime/*|cache|cache/*|*/cache|*/cache/*|sessions|sessions/*|*/sessions|*/sessions/*|tmp|tmp/*|*/tmp|*/tmp/*)
      return 1
      ;;
  esac
  return 0
}

secure_regular_file() {
  local path="$1"
  [[ -f "$path" && ! -L "$path" ]] || return 1
  [[ "$(stat -c '%u:%g:%a' -- "$path" 2>/dev/null || true)" == '0:0:600' ]]
}

secure_directory() {
  local path="$1"
  [[ -d "$path" && ! -L "$path" ]] || return 1
  [[ "$(stat -c '%u:%g:%a' -- "$path" 2>/dev/null || true)" == '0:0:700' ]]
}

validate_baseline_manifest() {
  local manifest="$1"
  /usr/bin/awk -F '\t' '
    function safe_path(p) {
      if (p == "" || p ~ /^\// || p == "." || p ~ /(^|\/)\.\.(\/|$)/) return 0
      if (p ~ /[\r\n\t]/) return 0
      return 1
    }
    function safe_word(v) { return v ~ /^[A-Za-z0-9_.-]+$/ || v == "UNAVAILABLE" }
    function safe_time(v) { return v ~ /^[0-9]{4}-[0-9]{2}-[0-9]{2}T[0-9]{2}:[0-9]{2}:[0-9]{2}Z$/ || v == "UNAVAILABLE" }
    BEGIN { bad = 0; rows = 0 }
    {
      if (NF != 8 && NF != 9) { bad = 1; next }
      if (!safe_path($1) || $2 !~ /^[0-9]+$/ || $3 !~ /^[0-9a-f]{64}$/) { bad = 1; next }
      if (!safe_word($4) || !safe_word($5) || $6 !~ /^[0-7]{3,4}$/ || !safe_time($7)) { bad = 1; next }
      if ($8 !~ /^(OWNED_RUNTIME_CODE|COMPOSER_DEPENDENCY|VERSIONED_DATABASE_CODE|DEVELOPMENT_OR_OPERATIONS|UNCLASSIFIED_RUNTIME_FILE)$/) { bad = 1; next }
      if (NF == 9 && $9 != "READABLE") { bad = 1; next }
      if (seen[$1]++) { bad = 1; next }
      rows++
    }
    END { if (rows == 0) bad = 1; exit bad ? 1 : 0 }
  ' "$manifest" || fail 'BASELINE_MANIFEST_INVALID'
}

load_baseline_target() {
  local baseline_dir="$BASELINE_ROOT/$baseline_id"
  local manifest="$baseline_dir/manifest.tsv"
  local manifest_sha stored_sha stored_id row_count row_cols

  secure_directory "$BASELINE_ROOT" || fail 'BASELINE_ROOT_SECURITY_INVALID'
  secure_directory "$baseline_dir" || fail 'BASELINE_DIRECTORY_SECURITY_INVALID'
  for file in manifest.tsv manifest.sha256 baseline-id metadata.txt; do
    secure_regular_file "$baseline_dir/$file" || fail 'BASELINE_FILE_SECURITY_INVALID'
  done

  stored_id="$(tr -d '\r\n' < "$baseline_dir/baseline-id")"
  [[ "$stored_id" == "$baseline_id" ]] || fail 'BASELINE_ID_FILE_MISMATCH'
  manifest_sha="$(sha256sum -- "$manifest" | awk '{print $1}')"
  stored_sha="$(tr -d '\r\n' < "$baseline_dir/manifest.sha256")"
  [[ "$stored_sha" == "$manifest_sha" ]] || fail 'BASELINE_MANIFEST_CHECKSUM_MISMATCH'
  grep -Fqx "baseline_id=$baseline_id" "$baseline_dir/metadata.txt" || fail 'BASELINE_METADATA_ID_MISMATCH'
  grep -Fqx "manifest_sha256=$manifest_sha" "$baseline_dir/metadata.txt" || fail 'BASELINE_METADATA_HASH_MISMATCH'
  grep -Fqx 'hash_unavailable=0' "$baseline_dir/metadata.txt" || fail 'BASELINE_HASH_INCOMPLETE'
  grep -Fqx 'metadata_unavailable=0' "$baseline_dir/metadata.txt" || fail 'BASELINE_METADATA_INCOMPLETE'
  grep -Fqx 'secrets_content=NOT_CAPTURED' "$baseline_dir/metadata.txt" || fail 'BASELINE_SECRETS_CONTRACT_INVALID'
  grep -Fqx 'persistent_content=NOT_CAPTURED' "$baseline_dir/metadata.txt" || fail 'BASELINE_PERSISTENT_CONTRACT_INVALID'
  grep -Fqx 'clinical_content=NOT_CAPTURED' "$baseline_dir/metadata.txt" || fail 'BASELINE_CLINICAL_CONTRACT_INVALID'

  validate_baseline_manifest "$manifest"
  row_count="$(awk -F '\t' -v target="$TARGET_RELATIVE_PATH" '$1 == target {count++} END {print count + 0}' "$manifest")"
  [[ "$row_count" == '1' ]] || fail 'BASELINE_TARGET_ROW_INVALID'
  row_cols="$(awk -F '\t' -v target="$TARGET_RELATIVE_PATH" '$1 == target {print NF; exit}' "$manifest")"
  if [[ "$row_cols" == '9' ]]; then
    IFS=$'\t' read -r _ baseline_size baseline_hash baseline_owner baseline_group baseline_mode baseline_mtime baseline_classification baseline_read_status < <(awk -F '\t' -v target="$TARGET_RELATIVE_PATH" '$1 == target {print; exit}' "$manifest")
    [[ "$baseline_read_status" == 'READABLE' ]] || fail 'BASELINE_TARGET_NOT_READABLE'
  elif [[ "$row_cols" == '8' ]]; then
    IFS=$'\t' read -r _ baseline_size baseline_hash baseline_owner baseline_group baseline_mode baseline_mtime baseline_classification < <(awk -F '\t' -v target="$TARGET_RELATIVE_PATH" '$1 == target {print; exit}' "$manifest")
  else
    fail 'BASELINE_TARGET_ROW_SHAPE_INVALID'
  fi
  [[ "$baseline_classification" == 'COMPOSER_DEPENDENCY' ]] || baseline_classification_ok='NO'
  [[ "$baseline_classification" == 'COMPOSER_DEPENDENCY' ]] && baseline_classification_ok='YES'
}

load_artifact_target() {
  local rel hash extra entries=0 target_count=0
  while IFS=$'\t' read -r rel hash extra; do
    [[ -z "${rel:-}" && -z "${hash:-}" && -z "${extra:-}" ]] && continue
    ((entries += 1))
    safe_relative_path "$rel" || fail 'ARTIFACT_MANIFEST_PATH_INVALID'
    [[ -z "${extra:-}" && "$hash" =~ ^[0-9a-f]{64}$ ]] || fail 'ARTIFACT_MANIFEST_ROW_INVALID'
    if [[ "$rel" == "$TARGET_RELATIVE_PATH" ]]; then
      ((target_count += 1))
      artifact_hash="$hash"
    fi
  done
  ((entries > 0)) || fail 'ARTIFACT_MANIFEST_EMPTY'
  [[ "$target_count" == '1' ]] || fail 'ARTIFACT_TARGET_ROW_INVALID'
}

collect_runtime() {
  local runtime_path="$APP_ROOT/$TARGET_RELATIVE_PATH"
  [[ -f "$runtime_path" && ! -L "$runtime_path" ]] || fail 'RUNTIME_TARGET_NOT_REGULAR'
  runtime_hash="$(sha256sum -- "$runtime_path" | awk '{print $1}')"
  [[ "$runtime_hash" =~ ^[0-9a-f]{64}$ ]] || fail 'RUNTIME_HASH_UNAVAILABLE'
  runtime_size="$(stat -c '%s' -- "$runtime_path")"
  runtime_mode="$(stat -c '%a' -- "$runtime_path")"
  runtime_owner="$(stat -c '%U' -- "$runtime_path")"
  runtime_group="$(stat -c '%G' -- "$runtime_path")"
  runtime_mtime_epoch="$(stat -c '%Y' -- "$runtime_path")"
  runtime_mtime="$(date -u -d "@$runtime_mtime_epoch" '+%Y-%m-%dT%H:%M:%SZ')"
}

classify() {
  if [[ "$baseline_classification_ok" != 'YES' ]]; then
    diagnosis='BASELINE_CLASSIFICATION_INSUFFICIENT'
  elif [[ "$artifact_hash" == "$runtime_hash" && "$runtime_hash" == "$baseline_hash" ]]; then
    diagnosis='ALL_THREE_MATCH'
  elif [[ "$artifact_hash" == "$runtime_hash" && "$runtime_hash" != "$baseline_hash" ]]; then
    diagnosis='BASELINE_MISMATCH_RUNTIME_ARTIFACT'
  elif [[ "$runtime_hash" == "$baseline_hash" && "$artifact_hash" != "$runtime_hash" ]]; then
    diagnosis='GENERATED_METADATA_BASELINE_MATCH_ARTIFACT_DIFFERS'
  elif [[ "$artifact_hash" == "$baseline_hash" && "$runtime_hash" != "$baseline_hash" ]]; then
    diagnosis='RUNTIME_DIFFERS_FROM_ARTIFACT_AND_BASELINE'
  else
    diagnosis='CAUSE_UNDETERMINED'
  fi
}

print_result() {
  local runtime_metadata baseline_metadata
  runtime_metadata="$runtime_size:$runtime_owner:$runtime_group:$runtime_mode:$runtime_mtime"
  baseline_metadata="$baseline_size:$baseline_owner:$baseline_group:$baseline_mode:$baseline_mtime"
  printf 'AUDIT_MODE=READ_ONLY\nMECHANISM_VERSION=%s\nTARGET_PATH=%s\n' "$MECHANISM_VERSION" "$TARGET_RELATIVE_PATH"
  printf 'ARTIFACT_SOURCE_SHA=%s\nARTIFACT_FILE_SHA256=NOT_EXPOSED\nRUNTIME_FILE_SHA256=NOT_EXPOSED\nBASELINE_FILE_SHA256=NOT_EXPOSED\n' "$artifact_sha"
  printf 'ARTIFACT_RUNTIME_HASH_EQUAL=%s\n' "$( [[ "$artifact_hash" == "$runtime_hash" ]] && printf YES || printf NO )"
  printf 'ARTIFACT_BASELINE_HASH_EQUAL=%s\n' "$( [[ "$artifact_hash" == "$baseline_hash" ]] && printf YES || printf NO )"
  printf 'RUNTIME_BASELINE_HASH_EQUAL=%s\n' "$( [[ "$runtime_hash" == "$baseline_hash" ]] && printf YES || printf NO )"
  printf 'BASELINE_CLASSIFICATION=%s\nBASELINE_CLASSIFICATION_VALID=%s\n' "$baseline_classification" "$baseline_classification_ok"
  printf 'COMPOSER_METADATA_EXCEPTION_ELIGIBLE=%s\n' "$( [[ "$baseline_classification_ok" == 'YES' && "$runtime_hash" == "$baseline_hash" && "$artifact_hash" != "$runtime_hash" ]] && printf YES || printf NO )"
  printf 'RUNTIME_FILE=REGULAR\nRUNTIME_SIZE=%s\nBASELINE_SIZE=%s\nRUNTIME_MODE=%s\nBASELINE_MODE=%s\nRUNTIME_METADATA_MATCH=%s\n' \
    "$runtime_size" "$baseline_size" "$runtime_mode" "$baseline_mode" "$( [[ "$runtime_metadata" == "$baseline_metadata" ]] && printf YES || printf NO )"
  printf 'DIAGNOSIS=%s\nEVIDENCE=THREE_WAY_COMPARISON_COMPLETE\nREADY_FOR_DEPLOY=NO\n' "$diagnosis"
  printf 'AUDIT=PASS\nPRODUCTION_CHANGED=NO\nDATABASE_CHANGED=NO\nWORKER_STARTED=NO\nBRIDGE_CALLED=NO\nSMB_CALLED=NO\nTRANSMISSION=NO\n'
}

require_root_and_caller
[[ "$#" -eq 4 && "$1" == '--baseline-id' && "$3" == '--artifact-sha' ]] || { usage; fail 'ARGUMENTS_INVALID'; }
baseline_id="$2"
artifact_sha="$4"
is_sha "$baseline_id" || fail 'BASELINE_ID_INVALID'
is_sha "$artifact_sha" || fail 'ARTIFACT_SHA_INVALID'

baseline_classification_ok='NO'
load_artifact_target
load_baseline_target
collect_runtime
classify
print_result
