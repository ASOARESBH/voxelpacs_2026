#!/usr/bin/env bash
# VOXEL PACS — gate root-controlled do drift integral.
#
# Recebe por stdin somente o manifesto do ÚLTIMO COMMIT PUBLICADO (construído
# pelo builder oficial com o SHA que está em produção), lê o baseline por SHA
# através do leitor fixo e executa o comparador versionado contra o runtime
# fixo. O gate acusa apenas alterações feitas fora do Git; o código novo a
# publicar não participa da comparação. Não aceita paths, comandos ou operações
# de publicação do caller.
set -Eeuo pipefail
umask 077
export PATH='/usr/sbin:/usr/bin:/sbin:/bin'

readonly RUNTIME_ROOT='/var/www/voxelpacs/app'
readonly READER='/usr/local/sbin/voxelpacs-runtime-drift-manifest-reader'
readonly COMPARATOR='/usr/local/sbin/voxelpacs-validate-runtime-drift'
readonly TEMP_ROOT='/var/tmp'
readonly MAX_PUBLISHED_MANIFEST_BYTES=20971520

fail() {
  printf 'RUNTIME_DRIFT_GATE=BLOCKED\nREASON=%s\nPRODUCTION_CHANGED=NO\nDATABASE_CHANGED=NO\nWORKER_STARTED=NO\nBRIDGE_CALLED=NO\nSMB_CALLED=NO\nTRANSMISSION=NO\n' "$1" >&2
  exit 64
}

usage() {
  printf '%s\n' 'uso: voxelpacs-runtime-drift-gate --baseline-id <40-hex-sha> < published-commit.manifest.tsv' >&2
}

require_root_and_caller() {
  [[ "$EUID" -eq 0 ]] || fail 'ROOT_REQUIRED'
  case "${SUDO_USER:-}" in
    ''|manus-admin) ;;
    *) fail 'CALLER_NOT_ALLOWLISTED' ;;
  esac
}

is_sha() {
  [[ "${1:-}" =~ ^[0-9a-f]{40}$ ]]
}

secure_executable() {
  local path="$1"
  [[ -f "$path" && ! -L "$path" && -x "$path" ]] || return 1
  [[ "$(stat -c '%u:%g:%a' -- "$path" 2>/dev/null || true)" == '0:0:555' ]]
}

require_root_and_caller
[[ "$#" -eq 2 && "$1" == '--baseline-id' ]] || { usage; fail 'ARGUMENTS_INVALID'; }
baseline_id="$2"
is_sha "$baseline_id" || fail 'BASELINE_ID_INVALID'
[[ -d "$RUNTIME_ROOT" && ! -L "$RUNTIME_ROOT" ]] || fail 'RUNTIME_ROOT_INVALID'
secure_executable "$READER" || fail 'READER_UNAVAILABLE'
secure_executable "$COMPARATOR" || fail 'COMPARATOR_UNAVAILABLE'
[[ -d "$TEMP_ROOT" && ! -L "$TEMP_ROOT" ]] || fail 'TEMP_ROOT_INVALID'

stage_dir="$(mktemp -d "$TEMP_ROOT/voxelpacs-runtime-drift-gate.XXXXXX")"
chmod 0700 "$stage_dir"
cleanup() {
  rm -f -- "$stage_dir/published.tsv" "$stage_dir/baseline.tsv"
  rmdir -- "$stage_dir" 2>/dev/null || true
}
trap cleanup EXIT

published_manifest="$stage_dir/published.tsv"
baseline_manifest="$stage_dir/baseline.tsv"
cat > "$published_manifest"
[[ -s "$published_manifest" ]] || fail 'PUBLISHED_MANIFEST_EMPTY'
published_bytes="$(stat -c '%s' -- "$published_manifest")"
[[ "$published_bytes" =~ ^[0-9]+$ && "$published_bytes" -le "$MAX_PUBLISHED_MANIFEST_BYTES" ]] || fail 'PUBLISHED_MANIFEST_TOO_LARGE'

if "$READER" read --baseline-id "$baseline_id" > "$baseline_manifest"; then
  :
else
  reader_rc=$?
  printf 'RUNTIME_DRIFT_GATE=BLOCKED\nREASON=BASELINE_READER_FAILED\nREADER_EXIT=%s\nPRODUCTION_CHANGED=NO\nDATABASE_CHANGED=NO\nWORKER_STARTED=NO\nTRANSMISSION=NO\n' "$reader_rc" >&2
  exit "$reader_rc"
fi

set +e
"$COMPARATOR" \
  --runtime-root "$RUNTIME_ROOT" \
  --published-manifest "$published_manifest" \
  --baseline-manifest "$baseline_manifest"
comparator_rc=$?
set -e
printf 'RUNTIME_DRIFT_MANIFEST_READER=PASS\nBASELINE_ID=%s\n' "$baseline_id"
exit "$comparator_rc"
