#!/usr/bin/env bash
# VOXEL PACS — leitor root-controlled do manifesto integral de drift.
#
# Somente leitura do baseline publicado. Não aceita path, arquivo, shell,
# comando ou operação de publicação fornecida pelo caller.
set -Eeuo pipefail
umask 077
export PATH='/usr/sbin:/usr/bin:/sbin:/bin'

readonly BASELINE_ROOT='/var/lib/voxelpacs/baselines'
readonly MECHANISM_VERSION='1'

fail() {
  printf 'MANIFEST_READER=BLOCKED\nREASON=%s\nPRODUCTION_CHANGED=NO\nDATABASE_CHANGED=NO\nWORKER_STARTED=NO\nTRANSMISSION=NO\n' "$1" >&2
  exit 64
}

usage() {
  printf '%s\n' 'uso: voxelpacs-runtime-drift-manifest-reader read --baseline-id <40-hex-sha>' >&2
}

is_sha() {
  [[ "${1:-}" =~ ^[0-9a-f]{40}$ ]]
}

require_root_and_caller() {
  [[ "$EUID" -eq 0 ]] || fail 'ROOT_REQUIRED'
  case "${SUDO_USER:-}" in
    ''|manus-admin|manus-deploy) ;;
    *) fail 'CALLER_NOT_ALLOWLISTED' ;;
  esac
}

secure_regular_file() {
  local path="$1"
  [[ -f "$path" && ! -L "$path" ]] || return 1
  [[ "$(stat -c '%u:%g:%a' -- "$path" 2>/dev/null || true)" == '0:0:600' ]]
}

secure_directory() {
  local path="$1"
  [[ -d "$path" && ! -L "$path" ]] || return 1
  [[ "$(stat -c '%u:%g:%a' -- "$path" 2>/dev/null || true)" == '0:0:700' ]]
}

validate_manifest() {
  local manifest="$1"
  /usr/bin/awk -F '\t' '
    function safe_path(p) {
      if (p == "" || p ~ /^\// || p == "." || p ~ /(^|\/)\.\.(\/|$)/) return 0
      if (p ~ /[\r\n\t]/) return 0
      if (p ~ /(^|\/)(\.env|storage|uploads|logs|backups|runtime|cache|sessions|tmp)(\/|$)/) return 0
      if (p ~ /(^|\/)public\/uploads(\/|$)/) return 0
      return 1
    }
    function safe_word(v) { return v ~ /^[A-Za-z0-9_.-]+$/ || v == "UNAVAILABLE" }
    function safe_time(v) { return v ~ /^[0-9]{4}-[0-9]{2}-[0-9]{2}T[0-9]{2}:[0-9]{2}:[0-9]{2}Z$/ || v == "UNAVAILABLE" }
    BEGIN { bad = 0; rows = 0 }
    {
      if (NF != 8 && NF != 9) { bad = 1; next }
      if (!safe_path($1) || $2 !~ /^[0-9]+$/ || $3 !~ /^[0-9a-f]{64}$/) { bad = 1; next }
      if (!safe_word($4) || !safe_word($5) || $6 !~ /^[0-7]{3,4}$/ || !safe_time($7)) { bad = 1; next }
      if ($8 !~ /^(OWNED_RUNTIME_CODE|COMPOSER_DEPENDENCY|VERSIONED_DATABASE_CODE|DEVELOPMENT_OR_OPERATIONS|UNCLASSIFIED_RUNTIME_FILE)$/) { bad = 1; next }
      if (NF == 9 && $9 != "READABLE") { bad = 1; next }
      if (seen[$1]++) { bad = 1; next }
      rows++
    }
    END { if (rows == 0) bad = 1; exit bad ? 1 : 0 }
  ' "$manifest" || fail 'MANIFEST_FORMAT_INVALID'
}

validate_metadata() {
  local metadata="$1" baseline_id="$2" manifest_sha="$3"
  grep -Fqx "baseline_id=$baseline_id" "$metadata" || fail 'METADATA_BASELINE_ID_MISMATCH'
  grep -Fqx "manifest_sha256=$manifest_sha" "$metadata" || fail 'METADATA_MANIFEST_SHA_MISMATCH'
  grep -Fqx 'hash_unavailable=0' "$metadata" || fail 'METADATA_HASH_INCOMPLETE'
  grep -Fqx 'metadata_unavailable=0' "$metadata" || fail 'METADATA_METADATA_INCOMPLETE'
  grep -Fqx 'secrets_content=NOT_CAPTURED' "$metadata" || fail 'METADATA_SECRETS_CONTRACT_INVALID'
  grep -Fqx 'persistent_content=NOT_CAPTURED' "$metadata" || fail 'METADATA_PERSISTENT_CONTRACT_INVALID'
  grep -Fqx 'clinical_content=NOT_CAPTURED' "$metadata" || fail 'METADATA_CLINICAL_CONTRACT_INVALID'
}

read_manifest() {
  local baseline_id="$1"
  local baseline_dir="$BASELINE_ROOT/$baseline_id"
  local manifest="$baseline_dir/manifest.tsv"
  local manifest_sha stored_sha stored_id

  secure_directory "$BASELINE_ROOT" || fail 'BASELINE_ROOT_SECURITY_INVALID'
  secure_directory "$baseline_dir" || fail 'BASELINE_DIRECTORY_SECURITY_INVALID'
  for file in manifest.tsv manifest.sha256 baseline-id metadata.txt symlinks.tsv exclusions.tsv; do
    secure_regular_file "$baseline_dir/$file" || fail 'BASELINE_FILE_SECURITY_INVALID'
  done

  stored_id="$(tr -d '\r\n' < "$baseline_dir/baseline-id")"
  [[ "$stored_id" == "$baseline_id" ]] || fail 'BASELINE_ID_FILE_MISMATCH'
  manifest_sha="$(sha256sum -- "$manifest" | awk '{print $1}')"
  [[ "$manifest_sha" =~ ^[0-9a-f]{64}$ ]] || fail 'MANIFEST_HASH_UNAVAILABLE'
  stored_sha="$(tr -d '\r\n' < "$baseline_dir/manifest.sha256")"
  [[ "$stored_sha" == "$manifest_sha" ]] || fail 'MANIFEST_CHECKSUM_MISMATCH'
  [[ "${manifest_sha:0:40}" == "$baseline_id" ]] || fail 'BASELINE_ID_DERIVATION_MISMATCH'
  validate_metadata "$baseline_dir/metadata.txt" "$baseline_id" "$manifest_sha"
  validate_manifest "$manifest"

  # stdout is intentionally the validated manifest only, so it can feed the
  # versioned drift comparator. No file content, PHI or secret is emitted.
  LC_ALL=C sort -t $'\t' -k1,1 -- "$manifest"
  printf 'MANIFEST_READER=PASS\nMECHANISM_VERSION=%s\nBASELINE_ID=%s\nMANIFEST_SHA256_PREFIX=%s…\nPRODUCTION_CHANGED=NO\nDATABASE_CHANGED=NO\nWORKER_STARTED=NO\nTRANSMISSION=NO\n' \
    "$MECHANISM_VERSION" "$baseline_id" "${manifest_sha:0:12}" >&2
}

require_root_and_caller
[[ "$#" -eq 3 && "$1" == 'read' && "$2" == '--baseline-id' ]] || { usage; fail 'ARGUMENTS_INVALID'; }
baseline_id="$3"
is_sha "$baseline_id" || fail 'BASELINE_ID_INVALID'
read_manifest "$baseline_id"
